GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_DIR=./data
# Optional shared access code for the four students. Use HTTPS.
STUDY_ACCESS_CODE=
MAX_DISTANCE=0.65
# lexical keeps the server small; semantic enables MiniLM + persistent ChromaDB.
RETRIEVAL_MODE=lexical
# Configure salted profile hashes with tools/set_profile.py; never commit actual hashes.
STUDENT_PROFILES_JSON=[]
